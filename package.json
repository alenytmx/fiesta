{
  "name": "fiesta-cotizaciones",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "test": "npm test -w server",
    "test:ui": "node tests/ui.cjs",
    "test:unit": "node --test server/validation.test.js server/security.test.js server/finance.test.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "jsdom": "^27.0.0",
    "esbuild": "^0.25.0"
  }
}
